# Copy to .env.local and fill in. .env.local is gitignored.
#
# Only NEXT_PUBLIC_* variables exist here, and that is deliberate: this app is a
# static export, so every value below is compiled into JavaScript the browser
# downloads. Treat all of them as public.
#
# The DeepSeek key, the SoldComps `sc_…` key, and the Google Places key are
# server-side only and must never appear in this file — they live in Track B's
# Cloud Function. See CLAUDE.md invariant 2.

# Where the browser fetches device_catalog.json from (Firebase Hosting CDN).
# Leave pointing at the local public/ copy until Track A publishes a real one.
NEXT_PUBLIC_CATALOG_URL=/device_catalog.json

# Base URL of the Track B serverless proxy (classification + Places endpoints).
# Not built yet; stub it locally when Track C starts calling it.
NEXT_PUBLIC_PROXY_BASE_URL=http://localhost:5001
