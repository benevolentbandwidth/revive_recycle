# Local secrets for server-side services only.
# Copy this file to .env and fill in your real values.
# Do not commit .env to git.

# SoldComps - starts with sc_
SOLDCOMPS_API_KEY=

# InferX / DeepSeek hosted model endpoint
INFERX_API_KEY=

# Google Places API key
GOOGLE_PLACES_API_KEY=

# Important:
# - None of these keys belong in the frontend app under web/.
# - The frontend is a static export, so browser-visible env vars are public by design.
# - Use .env only at the repo root for local development.
